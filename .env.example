# LLM provider: Groq.
# No Anthropic / OpenAI key is used by this project.
GROQ_API_KEY=

# Main conversational model chain — every active Groq text/chat model
# (confirmed via GET /openai/v1/models on 2026-07-17), ordered best to
# lightest. core/commands.py's _groq_complete() tries each in order, one
# attempt per model, falling through immediately on a rate limit, any other
# error, or an empty response, so a single model's outage/rate limit no
# longer means falling all the way to a static offline reply. Full history
# on why gpt-oss/qwen3 were previously avoided as a *single* primary model
# (spontaneous tool calls, latency spikes) — and why a multi-tier chain with
# a short per-tier timeout changes that calculus — is in GROQ_MODEL_CHAIN's
# module comment in core/commands.py, not duplicated here. Previously (as a
# single GROQ_MODEL var): llama-3.3-70b-versatile, before that
# openai/gpt-oss-20b, and before that deepseek-r1-distill-llama-70b
# (decommissioned by Groq on 2025-10-02; see
# https://console.groq.com/docs/deprecations).
GROQ_MODEL_CHAIN=

# Microphone to use for audio capture.
# Set to the exact device name shown by your OS (partial match is fine).
# Leave blank to let the system pick the default input device automatically.
MIC_NAME=

# One-time token used by /api/register_device to whitelist new devices.
# Change this to something secret before sharing the URL.
REGISTER_TOKEN=

# Serper.dev API key — primary web search provider for LIRA's search_web()
# (core/tools.py). Falls back to the DuckDuckGo Instant Answer API (no key
# needed) if this is missing or Serper's request fails.
SERPER_API_KEY=

# DeepSeek API key — primary LLM for core/code_engine.py's LLMRouter
# (generates/updates skills/ module code, model deepseek-coder). Falls back
# to a local Ollama qwen2.5-coder model (auto-pulled on first use) if this
# is missing or the DeepSeek call fails.
DEEPSEEK_API_KEY=

# TTS engine — 'kokoro' (default, or unset) keeps the original per-personality
# Kokoro voices. 'xtts' routes every personality through XTTS v2 instead,
# cloning the voice in data/voice_reference.wav (see core/tts_xtts.py),
# falling back to that personality's own Kokoro voice if XTTS fails (see
# core/commands.py's _say_for()). Requires data/voice_reference.wav to exist.
TTS_ENGINE=

# Bypasses Coqui's interactive Terms-of-Service prompt (CPML non-commercial
# license) on the XTTS v2 checkpoint's first download — see
# TTS.utils.manage.ModelManager.ask_tos()/tos_agreed(). Required for
# TTS_ENGINE=xtts to work unattended the first time it needs to download the
# model yet (a ~1.8GB one-time download); harmless once cached.
COQUI_TOS_AGREED=

# ── Discord bridge (core/discord_bridge.py) ─────────────────────────────────
# Lets Joan DM LIRA directly from Discord, routed through the same Groq +
# LIRA personality pipeline the voice assistant uses. Disabled by default —
# set to 'true' to start it (see core/server.py's start(), which calls
# core.discord_bridge.start_discord_bridge() at process startup).
DISCORD_ENABLED=false

# Bot token from the Discord Developer Portal (My Applications > your app >
# Bot > Reset Token). Required if DISCORD_ENABLED=true — without it the
# bridge logs a warning and never starts.
DISCORD_BOT_TOKEN=

# Joan's Discord user ID (right-click his profile in Discord with Developer
# Mode enabled > Copy User ID). The bridge only ever responds to DMs from
# this exact ID — every other DM is silently ignored, no response at all.
DISCORD_JOAN_ID=
