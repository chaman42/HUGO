<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for Electron's V8 JIT compiler under Hardened Runtime -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- Required by Electron's Chromium renderer under Hardened Runtime -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Required to load Electron's own unsigned frameworks -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Outbound network: Tailscale (100.x), localhost, GitHub update check -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- Microphone access for jarvis.py subprocess — required when the packaged
       app spawns Python directly (no Terminal.app intermediary). On macOS,
       TCC evaluates the responsible process (Electron/HUGO) for child processes,
       so this entitlement covers the Python subprocess's CoreAudio mic access. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
