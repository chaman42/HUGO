.DS_Store

# Old Terminal.app launch helper script — machine-specific (hardcoded
# absolute paths), auto-regenerated on every launch by the pre-refactor
# launcher.py. No longer written at all now that jarvis.py is spawned as a
# direct subprocess; ignored so a stray local copy is never re-committed.
_run_jarvis.sh

# Electron build artifacts
electron/node_modules/
electron/dist/
# Allow the macOS entitlements plist (*.plist is globally excluded above)
!electron/assets/*.plist
# Discord bridge launchd agent TEMPLATE — source, installed by
# scripts/install_discord_launchd.sh (which substitutes the real repo path
# and copies it to ~/Library/LaunchAgents, the actual local/generated file
# that stays untracked under the *.plist rule above).
!scripts/com.hugo.discord.plist

# Local build bookkeeping — the commit hash last successfully installed to
# /Applications/HUGO.app (see scripts/rebuild_app.sh). Purely local runtime
# state, never versioned — a stray `git add -A` must never pick this up.
electron/.app_version

# rebuild_app.sh's mkdir-based concurrency lock (prevents the manual update
# button and the 6-hourly autoupdate LaunchAgent from racing each other).
# Purely local runtime state — removed automatically on every script exit,
# but must never be versioned even if it's ever left behind by a crash.
.rebuild.lock/

# Root-level npm dependencies (Capacitor CLI/core/ios) — see package.json.
# Never versioned, same reasoning as electron/node_modules/ above.
node_modules/

# Capacitor iOS build artifacts — regenerated by scripts/build_ios.sh every
# run (cap sync / xcodebuild archive / -exportArchive), never source.
ios/App/App/public/
ios/App/HUGO.xcarchive/
ios/App/ipa/
ios/ExportOptions.plist
# Info.plist IS source (holds the mic/speech-recognition usage strings and
# the audio background mode) — allow it despite the global *.plist rule
# above, same pattern as electron/assets/*.plist's own negation.
!ios/App/App/Info.plist
