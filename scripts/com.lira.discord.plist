<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lira.discord</string>
    <key>ProgramArguments</key>
    <array>
        <string>/PATH/TO/REPO/venv/bin/python3</string>
        <string>/PATH/TO/REPO/core/discord_bridge.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/PATH/TO/REPO</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/PATH/TO/REPO/logs/discord_bridge.log</string>
    <key>StandardErrorPath</key>
    <string>/PATH/TO/REPO/logs/discord_bridge_error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
